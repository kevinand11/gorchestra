{
	"name": "gorchestra",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.5.0",
	"scripts": {
		"lint": "eslint \"libs/**/*.ts\"",
		"lint:fix": "eslint \"libs/**/*.ts\" --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "tsc -b --pretty false",
		"test": "pnpm -r --if-present test",
		"lint-staged": "lint-staged",
		"prepare": "husky"
	},
	"lint-staged": {
		"libs/**/*.ts": "eslint --fix",
		"*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}": "prettier --write"
	},
	"pnpm": {
		"overrides": {
			"@eslint/js": "9.39.1",
			"@k11/configs": "0.1.2",
			"eslint": "9.39.1",
			"prettier": "3.6.2",
			"typescript": "5.9.3",
			"typescript-eslint": "8.46.3",
			"valleyed": "4.5.20",
			"vitest": "3.2.4"
		}
	},
	"devDependencies": {
		"@eslint/js": "9.39.1",
		"@k11/configs": "0.1.2",
		"@types/node": "24.10.1",
		"eslint": "9.39.1",
		"husky": "9.1.7",
		"lint-staged": "15.5.2",
		"prettier": "3.6.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.46.3",
		"vitest": "3.2.4"
	}
}
