{
	"name": "gorchestra",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/main.ts --dev | pino-pretty",
		"start": "tsx --env-file-if-exists=.env src/main.ts",
		"lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint \"{src,libs,consumers}/**/*.ts\"",
		"lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint \"{src,libs,consumers}/**/*.ts\" --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "pnpm typecheck:ts && pnpm typecheck:packages",
		"typecheck:ts": "tsc -b --pretty false",
		"typecheck:packages": "pnpm -r --if-present typecheck",
		"test": "pnpm -r --if-present test",
		"fallow": "fallow",
		"fallow:audit": "fallow audit",
		"fallow:audit:json": "fallow audit --format json",
		"fallow:health": "fallow health --score",
		"fallow:dead-code": "fallow dead-code",
		"commitlint": "commitlint",
		"lint-staged": "lint-staged",
		"prepare": "husky"
	},
	"lint-staged": {
		"{src,libs,consumers}/**/*.ts": "eslint --fix",
		"*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}": "prettier --write"
	},
	"dependencies": {
		"@gorchestra/consumer-server": "workspace:*",
		"valleyed": "latest"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@k11/configs": "^0.1.2",
		"@types/node": "^25.9.2",
		"eslint": "^9.39.1",
		"pino-pretty": "^13.1.3",
		"fallow": "^2.90.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"prettier": "^3.8.3",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vitest": "^4.1.8"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		],
		"rules": {
			"header-max-length": [
				2,
				"always",
				100
			],
			"subject-case": [
				2,
				"never",
				[
					"sentence-case",
					"start-case",
					"pascal-case",
					"upper-case"
				]
			],
			"scope-case": [
				2,
				"always",
				"lower-case"
			]
		}
	}
}
